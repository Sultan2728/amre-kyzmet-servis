rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /reviews/{reviewId} {
      // Читать отзывы может кто угодно
      allow read: if true;

      // Оставить новый отзыв может кто угодно, но только в правильном формате
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'rating', 'text', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.createdAt == request.time;

      // Никто не может менять или удалять чужие отзывы через сайт
      allow update, delete: if false;
    }

    // Новости и объявления: читать может кто угодно,
    // писать — только администратор (вошедший по email).
    match /news/{newsId} {
      allow read: if true;
      allow create, update: if
        request.auth != null &&
        request.auth.token.email == 'shaken.sultan.02@gmail.com' &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000 &&
        request.resource.data.image is string &&
        request.resource.data.image.size() <= 600000;
      allow delete: if
        request.auth != null &&
        request.auth.token.email == 'shaken.sultan.02@gmail.com';
    }
  }
}
